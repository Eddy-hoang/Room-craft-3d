#include <winver.h>

101 ICON "../assets/icons/roomcraft.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "RoomCraft 3D Project"
            VALUE "FileDescription", "RoomCraft 3D - Desktop 3D Interior Design and Room Planner"
            VALUE "FileVersion", "1.0.0-rc1"
            VALUE "InternalName", "RoomCraft3D"
            VALUE "LegalCopyright", "RoomCraft 3D Academic Computer Graphics Project"
            VALUE "OriginalFilename", "RoomCraft3D.exe"
            VALUE "ProductName", "RoomCraft 3D"
            VALUE "ProductVersion", "1.0.0-rc1"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
