{
  "$schema": "https://raw.githubusercontent.com/microsoft/vcpkg-tool/main/docs/vcpkg.schema.json",
  "name": "roomcraft-3d",
  "version-string": "0.1.0",
  "description": "RoomCraft 3D - Desktop 3D Interior Design and Room Planner (OpenGL 3.3 Core + FreeGLUT + Dear ImGui + GLM)",
  "builtin-baseline": "9fa95bf687fa6ae7f2da0673a8067e5fc1515c27",
  "dependencies": [
    "freeglut",
    "glm",
    {
      "name": "glad",
      "features": [
        "gl-api-33"
      ]
    },
    {
      "name": "imgui",
      "features": [
        "glut-binding",
        "opengl3-binding",
        "docking-experimental"
      ]
    }
  ]
}
